{
  "name": "email-scheduler-backend",
  "version": "1.0.0",
  "description": "ReachInbox Email Scheduler Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "ts-node-dev --respawn --transpile-only src/worker/index.ts",
    "worker:build": "tsc",
    "worker:start": "node dist/worker/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.10.0",
    "@prisma/client": "^5.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^4.12.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^9.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.7",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.13",
    "@types/uuid": "^9.0.6",
    "prisma": "^5.5.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "vitest": "^2.1.9"
  }
}
