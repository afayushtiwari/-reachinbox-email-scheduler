# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Ethereal Email (auto-generated on first run)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=auto_generated
ETHEREAL_PASS=auto_generated

# Mail provider (smtp | mailtrap | sendgrid | resend). Leave blank for auto-detect.
MAIL_PROVIDER=
MAILTRAP_API_TOKEN=
MAILTRAP_SANDBOX_ID=
SENDGRID_API_KEY=
RESEND_API_KEY=
# Default From address when scheduling doesn't specify a sender (use an authenticated domain).
DEFAULT_FROM_EMAIL=

# Rate Limiting
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=10
MIN_DELAY_BETWEEN_EMAILS_MS=1000

# Worker
WORKER_CONCURRENCY=3

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development